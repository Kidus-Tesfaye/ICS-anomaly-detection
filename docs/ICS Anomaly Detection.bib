  booktitle = {2025 5th {{International Conference}} on {{Electrical}}, {{Computer}}, {{Communications}} and {{Mechatronics Engineering}} ({{ICECCME}})},
  author = {Almaini, Amar and Folz, Jakob and Ashour, Ghadeer},
  year = 2025,
