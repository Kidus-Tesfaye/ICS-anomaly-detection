  title = {Robust {{Anomaly Detection}} for {{Secure Water Treatment Systems Under Adversarial Attack Scenarios}}},
  booktitle = {2026 8th {{International Youth Conference}} on {{Radio Electronics}}, {{Electrical}} and {{Power Engineering}} ({{REEPE}})},
  author = {Alnatsheh, Rania J. and Maged, Ahmed and Shaaban, Mostafa F.},
  year = 2026,
  month = apr,
  pages = {1--6},
  publisher = {IEEE},
  address = {Moscow, Russian Federation},
  doi = {10.1109/REEPE69046.2026.11481402},
  url = {https://ieeexplore.ieee.org/document/11481402/},
  urldate = {2026-07-28},
  abstract = {Industrial Control Systems (ICS) for critical infrastructure, such as water treatment facilities, are increasingly vulnerable to sophisticated cyber-physical attacks. While machine learning-based intrusion detection systems have demonstrated high accuracy in detecting anomalies, they are susceptible to adversarial attacks that can evade detection. This paper presents a novel two stage defense framework combining a CNN-LSTM supervised intrusion detector with an unsupervised adversarial detection layer specifically designed for the Secure Water Treatment (SWaT) testbed. We implement and evaluate three state-of-the-art adversarial attacks (i.e., Fast Gradient Sign Method (FGSM), Projected Gradient Descent (PGD), and Carlini-Wagner (C\&W)) with physical constraints relevant to ICS environments. The proposed optimal ensemble detector, combining Isolation Forest and Variational Autoencoder (VAE) methods, achieves 97.00\% detection accuracy against adversarial examples while maintaining low false positive rates outperforming baseline approaches.},
  copyright = {https://doi.org/10.15223/policy-029},
  isbn = {979-8-3315-4759-2},
  keywords = {anomaly detection,Machine Learning (ML),ML,time-series},
  note = {Industrial Control Systems (ICS) for critical infrastructure, such as water treatment facilities, are increasingly vulnerable to sophisticated cyber-physical attacks. While machine learning-based intrusion detection systems have demonstrated high accuracy in detecting anomalies, they are susceptible to adversarial attacks that can evade detection. This paper presents a novel two stage defense framework combining a CNN-LSTM supervised intrusion detector with an unsupervised adversarial detection layer specifically designed for the Secure Water Treatment (SWaT) testbed. We implement and evaluate three state-of-the-art adversarial attacks (i.e., Fast Gradient Sign Method (FGSM), Projected Gradient Descent (PGD), and Carlini-Wagner (C\&W)) with physical constraints relevant to ICS environments. The proposed optimal ensemble detector, combining Isolation Forest and Variational Autoencoder (VAE) methods, achieves 97.00\% detection accuracy against adversarial examples while maintaining low false positive rates outperforming baseline approaches.},
